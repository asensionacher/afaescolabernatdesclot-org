# ============================================
# AFA Escola Bernat Desclot - Variables de entorno
# Copia este fichero a .env y rellena los valores:
#   cp .env.example .env
# ============================================

# --- Base de datos (PostgreSQL) ---
# Desarrollo local (docker compose up -d):
DATABASE_URL="postgresql://afa:afa@localhost:5432/afa?schema=public"
# Producción (Neon / Vercel Postgres / Supabase):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# --- Autenticación ---
# Secreto para firmar las cookies de sesión (JWT HS256).
# Genera uno con: openssl rand -hex 32
JWT_SECRET="cambia-este-secreto-por-uno-de-64-caracteres-hexadecimales"

# --- Cifrado de credenciales SMTP guardadas en el panel de admin ---
# Clave de 32 bytes en hex (AES-256-GCM). Misma idea:
# openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY="cambia-esta-clave-por-una-de-64-caracteres-hexadecimales"

# --- Sitio ---
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- Correo (SMTP) ---
# El servidor SMTP, el usuario y la contraseña se configuran desde el panel de
# administración (Configuración -> Correo electrónico) y se guardan cifrados en la
# base de datos. Sólo hace falta CREDENTIALS_ENCRYPTION_KEY para poder cifrarlos.
