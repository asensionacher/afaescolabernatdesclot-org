# ============================================
# AFA Escola Bernat Desclot - Environment Variables
# ============================================
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
#
# NEVER commit .env.local to git!
# ============================================

# --- Sanity CMS ---
NEXT_PUBLIC_SANITY_PROJECT_ID=cpaqkfmb
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-21
SANITY_API_TOKEN=your_sanity_api_token_here

# --- Google Analytics (optional) ---
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# --- Site URL ---
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# --- Telegram Bot (for registration form notifications) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Authentication for /actas (Meeting Minutes) ---
# Generate these with: ./scripts/generate-security-credentials.sh "YourPassword"
#
# JWT_SECRET: 512-bit hex string for signing session tokens
# ACTAS_PASSWORD_HASH_BASE64: Base64-encoded bcrypt hash of the password
#   (base64 encoding avoids $ character issues in Next.js env parsing)
JWT_SECRET=your_jwt_secret_here
ACTAS_PASSWORD_HASH_BASE64=your_base64_encoded_bcrypt_hash_here
