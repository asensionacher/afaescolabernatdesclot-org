# Sanity Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-21
SANITY_API_TOKEN=your_token_here

# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Base URL for production (update when deployed)
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# Telegram Bot (for registration form)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Meeting Minutes (Actas) Authentication
# Generate these values with: ./scripts/generate-security-credentials.sh "YourPassword"
# JWT_SECRET: Random 512-bit secret for signing session tokens (NEVER share this)
# ACTAS_PASSWORD_HASH_BASE64: Base64-encoded bcrypt hash (avoids $ character issues)
JWT_SECRET=generate_with_script_above
ACTAS_PASSWORD_HASH_BASE64=generate_with_script_above
